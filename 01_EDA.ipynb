# 01_EDA.ipynb 信贷风控 EDA 探索性数据分析
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import warnings
warnings.filterwarnings('ignore')

# 读取数据
df = pd.read_csv("loan_data.csv")

# 1. 基础信息查看
print("数据集形状：", df.shape)
print("\n前5行数据：")
print(df.head())
print("\n数据类型：")
print(df.dtypes)
print("\n缺失值统计：")
print(df.isnull().sum())

# 2. 标签分布（好坏客户）
print("\n违约标签分布：")
print(df['target'].value_counts())
df['target'].value_counts().plot(kind='bar')
plt.title("好坏客户样本分布")
plt.show()

# 3. 描述性统计
print("\n连续特征统计描述：")
print(df.describe())

# 4. 箱线图，IQR识别异常值（你学习的知识点）
plt.figure(figsize=(10,4))
df[['income']].boxplot()
plt.title("收入特征箱线图，用于异常值检测")
plt.show()

# 5. 特征相关性热力图
corr = df.corr()
print("\n特征相关系数：")
print(corr)
